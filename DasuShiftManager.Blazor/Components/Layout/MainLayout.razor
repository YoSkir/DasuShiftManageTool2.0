@using MudBlazor.Utilities
@inherits LayoutComponentBase

@* Required *@
<MudThemeProvider Theme="_myCustomTheme" IsDarkMode="true"/>
<MudPopoverProvider />

@* Needed for dialogs *@
<MudDialogProvider />

@* Needed for snackbars *@
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Dense="true">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Primary" Edge="Edge.Start" OnClick="@ToggleDrawer" />
        <MudSpacer />
        <MudText>大樹藥局排班系統</MudText>
        <MudSpacer />
        <MudIconButton Icon="@Icons.Custom.Brands.GitHub" Color="Color.Primary" Href="https://github.com/YoSkir/DasuShiftManageTool2.0" Target="_blank" />
    </MudAppBar>
    <MudDrawer @bind-Open="@_open" ClipMode="DrawerClipMode.Docked" Breakpoint="Breakpoint.Md" Elevation="1" Variant="@DrawerVariant.Mini">
        <MudNavMenu>

            <MudNavLink Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.LibraryBooks" Href="schedule-report">班表</MudNavLink>
            <MudNavLink Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Group">Community</MudNavLink>
            <MudNavLink Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Settings" Href="setting">設定</MudNavLink>
        </MudNavMenu>
    </MudDrawer>
    <MudMainContent Class="pt-16 px-16">
        <MudContainer Class="mt-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code{
    private bool _open = false;

    private readonly MudTheme _myCustomTheme = new()
    {
        PaletteDark = new PaletteDark()
        {
            Primary = "#D7CCC8",          
            Secondary = "#26A69A",        
            AppbarBackground = "#004D40",  
            Background = "#212121",        
            Surface = "#37474F",            
            DrawerBackground =  "#212121",
        }
    };
    
    private void ToggleDrawer()
    {
        _open = !_open;
    }
}