@page "/setting"
@using DasuShiftManager.Server.Entity.Setting

<MudText Typo="Typo.h4" Class="mb-4">設定</MudText>

@if (isLoading)
{
    <MudProgressLinear Indeterminate="true" Class="my-7"></MudProgressLinear>
}
else
{
    <MudNumericField @bind-Value="_setting.ShiftStartDay" Label="每月班表起始日期" Min="1" Max="28" 
                     For="() => _setting.ShiftStartDay"></MudNumericField>
    <MudTimePicker Label="開班時間" @bind-Time ="_setting.ShiftStartTime" MinuteSelectionStep="30" TimeFormat="HH:mm"
                   Editable="false" Variant="Variant.Outlined" For="@(() => _setting.ShiftStartTime)"/>
    <MudTimePicker Label="關班時間" @bind-Time="_setting.ShiftEndTime" MinuteSelectionStep="30" TimeFormat="HH:mm"
                   Editable="false" Variant="Variant.Outlined" For="@(() => _setting.ShiftEndTime)"/>
}

@code
{
    private bool isLoading = true;
    private SettingDto _setting;


    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            _setting = new SettingDto();
        }
        catch (Exception e)
        {

        }
        finally
        {
            isLoading = false;
        }
    }
}
