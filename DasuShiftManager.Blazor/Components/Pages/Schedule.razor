@page "/"
@using DasuShiftManager.Core.Data
@using DasuShiftManager.Core.Entities
@using DasuShiftManager.Core.GenerateTool
@using DasuShiftManager.Shared
@using ShiftType = DasuShiftManager.Shared.ShiftType
@inherits LayoutComponentBase
@inject IDialogService DialogService


<MudContainer MaxWidth="MaxWidth.False" Style="width: 100%" Class="mt-4">
    @if (showFailAlert)
    {
        <MudAlert Severity="Severity.Warning" ContentAlignment="HorizontalAlignment.Center" ShowCloseIcon="true"
                  CloseIconClicked="(() => CloseAlert(true))">排班失敗 請檢查降低所需工時
        </MudAlert>
    }
    <MudGrid Spacing="3">
        <MudItem xs="12" md="10">
            <div style="overflow-x: auto;">
                <table class="schedule-table">
                    <thead>
                    <!-- 第一層標頭：職級 -->
                    <tr>
                        <th rowspan="3" colspan="2" class="bg-yellow fix-col-2">日期</th>
                        <th colspan="1" class="bg-yellow">職級</th>
                        @foreach (var staff in _staffList)
                        {
                            <th class="bg-yellow">@_getTitleZh(staff.StaffType)</th>
                        }
                    </tr>
                    <!-- 第三層標頭：姓名與班別標記 -->
                    <tr>
                        <th class="bg-yellow">姓名</th>
                        @foreach (var staff in _staffList)
                        {
                            <th class="bg-yellow">@staff.Name</th>
                        }
                    </tr>
                    </thead>
                    <tbody>
                    @{ var rowIndex = 0; }
                    @foreach (var row in _scheduleRowModels)
                    {
                        rowIndex++;
                        <tr>
                            @{
                                shiftCellClass = (rowIndex & 1) == 0 ? "bg-green" : "bg-green-dark";
                            }
                            <td class="@shiftCellClass font-bold">@row.DayOfMonth</td>
                            <td class="@shiftCellClass font-bold">@row.DayOfWeek</td>
                            @{
                                shiftCellClass = (rowIndex & 1) == 0 ? "bg-yellow" : "bg-yellow-dark";
                            }
                            <td class="@shiftCellClass"></td>

                            <!-- 員工個人排班（資料填寫區） -->
                            @foreach (var shift in row.Shift)
                            {
                                <td class="@shiftCellClass @SelectShiftClass(shift)"
                                    @onclick="() => SelectShift(shift)">
                                    @shift.Msg
                                </td>
                            }
                        </tr>
                    }
                    </tbody>
                    <tfoot>
                    <tr class="bg-yellow font-bold">
                        <td colspan="3">總時數(含所有假別及補休)</td>
                        @foreach (var hr in _totalHr)
                        {
                            <td>@hr</td>
                        }
                    </tr>
                    <tr class="bg-yellow-dark font-bold">
                        <td colspan="3">總休假</td>
                        @foreach (var day in _totalRest)
                        {
                            <td>@day</td>
                        }
                    </tr>
                    <tr class="bg-yellow font-bold">
                        <td rowspan="3">班別統計</td>
                        <td colspan="2">早班(次)</td>
                        @foreach (var c in _early)
                        {
                            <td>@c</td>
                        }
                    </tr>
                    <tr class="bg-yellow font-bold">
                        <td colspan="2">晚班(次)</td>
                        @foreach (var c in _late)
                        {
                            <td>@c</td>
                        }
                    </tr>
                    <tr class="bg-yellow font-bold">
                        <td colspan="2">全班(次)</td>
                        @foreach (var c in _all)
                        {
                            <td>@c</td>
                        }
                    </tr>
                    </tfoot>
                </table>
            </div>
        </MudItem>
        <MudItem xs="12" md="2">
            <MudPaper Class="pa-3 mb-2" Color="Color.Primary" Style=" border: 1px solid #111;">
                <MudGrid Spacing="1" Justify="Justify.SpaceBetween">
                    <MudTextField @bind-Value="_minWorkHr" Label="最低所需時數" Variant="Variant.Outlined"/>
                    <MudTextField @bind-Value="_minRestDay" Label="最低休假日" Variant="Variant.Outlined"/>
                    <MudDatePicker Label="開始日期" Date="_startDate" DateChanged="GenerateTable"/>
                    <MudButton Variant="Variant.Outlined" Color="Color.Tertiary" OnClick="@Generate"
                               Class="justify-center mt-4">設定前一份班表
                    </MudButton>
                    <MudButton Disabled="@_processing" Variant="Variant.Filled" Color="Color.Tertiary"
                               OnClick="@Generate" Size="Size.Large" Class="justify-center mt-8">
                        @if (_processing)
                        {
                            <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true"/>
                            <MudText Class="ms-2">排班中</MudText>
                        }
                        else
                        {
                            <MudText>開始排班</MudText>
                        }
                    </MudButton>
                </MudGrid>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>

<!-- 4. 專屬樣式設定 (貼近圖中的 Excel 報表質感) -->
<style>
    .schedule-table {
        width: 100%;
        border-collapse: collapse;
        text-align: center;
        font-size: 13px;
        font-family: "Microsoft JhengHei", sans-serif;
    }

    .schedule-table th, .schedule-table td {
        border: 1px solid #000;
        padding: 4px 2px;
        height: 28px;
    }

    /* 背景顏色比照原圖 */
    .bg-yellow {
        background-color: #FFFFCC !important;
        color: black;
    }

    .bg-yellow-dark {
        background-color: #dfdfa2 !important;
        color: black
    }

    .bg-green {
        background-color: #CCFFCC !important;
        color: black;
    }

    .bg-green-dark {
        background-color: #aee1ae !important;
        color: black;
    }

    /* 直立文字 (姓名) */
    .vertical-text {
        writing-mode: vertical-lr;
        text-orientation: upright;
        letter-spacing: 4px;
        padding: 8px 4px !important;
    }

    .font-bold {
        font-weight: bold;
    }

    .text-large {
        font-size: 18px;
        font-weight: bold;
    }

    .td-border {
        border: 3px solid #518bf6 !important; /* 有邊框 (例如 MudBlazor Primary 色) */
        color: #3866ac;
    !important;
    }

</style>

@code {

    private ShiftCreateTool _createTool;

    // 模擬排班資料列
    private List<ScheduleRowModel> _scheduleRowModels = [];
    private List<Staff> _staffList;
    private List<string> _totalHr = [];
    private string shiftCellClass;
    private string setShiftClass;
    private List<int> _totalRest = [];
    private List<int> _early = [];
    private List<int> _all = [];
    private List<int> _late = [];
    private bool showFailAlert = false;

    private IShiftGenerator _generator;
    private IDataGetter _dataGetter;
    private int _minWorkHr;
    private int _minRestDay;
    private DateTime? _startDate;
    private bool _processing;

    protected override void OnInitialized()
    {
        _dataGetter = new TestDataGetter();
        _staffList = _dataGetter.GetStaffList();
        _createTool = new ShiftCreateTool(_dataGetter);
        _generator = new DcDfsShiftGenerator();
        var defaultSetting = _dataGetter.GetSetting();
        _minWorkHr = defaultSetting.MinMonthWorkHrs;
        _minRestDay = defaultSetting.MinMonthRestDays;
        _startDate = DateTime.Now;
        GenerateTable(_startDate);
    }

    private string _getShiftStr(ShiftInfo? shiftInfo, bool pto)
    {
        if (shiftInfo == null) return "";
        if (shiftInfo.DayOff)
        {
            if (pto)
                return "特6H";
            return "/";
        }

        var startHh = shiftInfo.StartArrHalfHr + 18;
        var start = _getHalfHrShow(startHh);
        var end = _getHalfHrShow(startHh + shiftInfo.WorkHalfHrs);
        var back = _getRestHalfHour(shiftInfo.WorkHalfHrs);
        return $"{start}-{end}{back}";
    }

    private string _getHalfHrShow(int halfHr)
    {
        return $"{(halfHr) / 2:D2}{((halfHr & 1) == 0 ? 0 : 3)}";
    }

    private string _getDayOfWeekName(int day)
    {
        string[] days = ["日", "一", "二", "三", "四", "五", "六"];
        return days[day];
    }

    private static string _getRestHalfHour(int workHalfHours)
    {
        if (workHalfHours > 17)
            return "休1";
        return "休.5";
    }

    public class ScheduleRowModel
    {
        public int DayOfMonth { get; set; }
        public string DayOfWeek { get; set; } = "";
        public List<ShiftItem> Shift { get; set; } = [];
    }

    public class ShiftItem
    {
        public int StaffId { get; init; }
        public DateOnly Date { get; init; }
        public string Msg { get; set; }
        public ShiftSelectDialog.SelectedShiftDto? ChosenShift { get; set; }
        public ShiftInfo? ShiftInfo{ get; init; }
        public ShiftType? ShiftType { get; set; } = null;
    }

    private string _getTitleZh(StaffType staffType)
    {
        return staffType switch
        {
            StaffType.Normal => "專員",
            StaffType.Manager => "店長",
            StaffType.Pharmacist => "調劑",
            _ => throw new ArgumentOutOfRangeException(nameof(staffType), staffType, null)
        };
    }

    private async Task StartShift()
    {
        await Generate();
    }

    private async Task Generate()
    {
        _processing = true;
        showFailAlert = false;

        StateHasChanged();
        await Task.Yield();

        var startDate = DateOnly.FromDateTime(_startDate.Value);
        ShiftCreateResult result;
        var dto = new ShiftGenerateDto()
        {
            Day = startDate.Day,
            MinWorkHrs = _minWorkHr,
            MinRestDay = _minRestDay,
            PtoStaffList = PtoStaffList,
            AssignedShiftList = AssignedShiftList,
            VacationList = VacationList
        };
        try
        {
            result = await Task.Run(() => _createTool.GenerateThisMonthShift(startDate.Year, startDate.Month, _generator, dto));
        }
        catch (Exception e)
        {
            showFailAlert = true;
            _processing = false;
            StateHasChanged();
            return;
        }

        _scheduleRowModels.Clear();
        _totalHr.Clear();
        _totalRest.Clear();
        _early.Clear();
        _all.Clear();
        _late.Clear();

        _scheduleRowModels.Clear();
        var date = result.Context.StartDate;
        while (date <= result.Context.EndDate)
        {
            var schedule = new ScheduleRowModel
            {
                DayOfMonth = date.Day,
                DayOfWeek = _getDayOfWeekName((int)date.DayOfWeek),
            };
            foreach (var staff in result.Context.StaffList)
            {
                ShiftSelectDialog.SelectedShiftDto? chosenShift = null;
                if (PtoStaffList.TryGetValue(date, out var p) && p.Contains(staff.Id))
                    chosenShift = new ShiftSelectDialog.SelectedShiftDto() { Pto = true, DayOff = true,SelectedShift = ShiftSelectDialog.Shift.特休};
                else if (VacationList.TryGetValue(date, out var v) && v.Contains(staff.Id))
                    chosenShift = new ShiftSelectDialog.SelectedShiftDto() { DayOff = true ,SelectedShift = ShiftSelectDialog.Shift.指休};
                else if (AssignedShiftList.TryGetValue(staff.Id, out var s)
                         && s.TryGetValue(date, out var shiftInfo))
                    chosenShift = new ShiftSelectDialog.SelectedShiftDto()
                    {
                        StartHalfHr = shiftInfo.StartArrHalfHr,
                        WorkHr = shiftInfo.WorkHalfHrs,
                        SelectedShift = ShiftSelectDialog.Shift.上班
                    };
                var shift=result.Context.ShiftState.GetShiftCopy(staff.Id, date);
                var pto = result.Context.PtoData.TryGetValue(date, out var ptoIdList) && ptoIdList.Contains(staff.Id);
                schedule.Shift.Add(new ShiftItem()
                {
                    StaffId = staff.Id,
                    Date = date,
                    Msg = _getShiftStr(shift,pto),
                    ShiftType = _getShiftType(result.Context, staff.Id, date),
                    ChosenShift = chosenShift,
                    ShiftInfo = shift
                });
            }

            _scheduleRowModels.Add(schedule);
            date = date.AddDays(1);
        }

        foreach (var staff in result.Context.StaffList)
        {
            var totalHr = result.Context.ShiftState.GetTotalWorkHalfHrs(staff.Id) / 2;
            _totalHr.Add($"{_minWorkHr} 加{totalHr - _minWorkHr}");
            _totalRest.Add(result.Context.ShiftState.GetTotalRestDays(staff.Id));
            _early.Add(result.Context.ShiftType.Early[staff.Id]);
            _late.Add(result.Context.ShiftType.Late[staff.Id]);
            _all.Add(result.Context.ShiftType.All[staff.Id]);
        }

        _processing = false;
        StateHasChanged();
    }

    private ShiftType? _getShiftType(ShiftCreateContext context, int staffId, DateOnly date)
    {
        var shiftInfo = context.ShiftState.GetShiftCopy(staffId, date);
        return shiftInfo.Type;
    }

    private Task CloseAlert(bool b)
    {
        showFailAlert = false;
        return Task.CompletedTask;
    }

    private async Task GenerateTable(DateTime? newDate)
    {
        _startDate = newDate;
        var date = DateOnly.FromDateTime(_startDate.Value);
        var end = date.AddDays(27);
        _scheduleRowModels.Clear();
        while (date <= end)
        {
            var schedule = new ScheduleRowModel
            {
                DayOfMonth = date.Day,
                DayOfWeek = _getDayOfWeekName((int)date.DayOfWeek),
            };
            foreach (var staff in _staffList)
            {
                schedule.Shift.Add(new ShiftItem() { StaffId = staff.Id, Date = date, Msg = "" });
            }

            _scheduleRowModels.Add(schedule);
            date = date.AddDays(1);
        }
    }

    private ShiftItem? _selectedShift;

    private Dictionary<DateOnly, List<int>> PtoStaffList { get; } = [];
    private Dictionary<int, Dictionary<DateOnly, ShiftInfo>> AssignedShiftList { get; } = [];
    private Dictionary<DateOnly, List<int>> VacationList { get; } = [];

    private async Task SelectShift(ShiftItem shift)
    {
        _selectedShift = shift;
        var param = new DialogParameters<ShiftSelectDialog>()
        {
            { x => x.CurrentShift, shift.ChosenShift }
        };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.ExtraSmall };
        var dialog = await DialogService.ShowAsync<ShiftSelectDialog>("指定班別", param, options);
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: ShiftSelectDialog.SelectedShiftDto selectedShiftDto })
        {
            //檢查是否為原有
            //加入指班指休
            var shiftInfo = shift.ShiftInfo;
            //如果原有 刪除指班指休
            if (shift.ChosenShift != null)
            {
                if(shift.ChosenShift.Pto)
                    PtoStaffList[shift.Date].Remove(shift.StaffId);
                else if(shift.ChosenShift.DayOff)
                    VacationList[shift.Date].Remove(shift.StaffId);
                else if (shift.ChosenShift.SelectedShift==ShiftSelectDialog.Shift.上班
                    &&AssignedShiftList.TryGetValue(shift.StaffId, out var shiftDic))
                    shiftDic.Remove(shift.Date);
            }

            if (selectedShiftDto.SelectedShift == ShiftSelectDialog.Shift.無)
                shift.ChosenShift = null;
            else if (selectedShiftDto.DayOff)
            {
                shiftInfo = new ShiftInfo();
                if (selectedShiftDto.Pto)
                    if (PtoStaffList.TryGetValue(shift.Date, out var ids))
                        ids.Add(shift.StaffId);
                    else PtoStaffList[shift.Date] = [shift.StaffId];
                else if (VacationList.TryGetValue(shift.Date, out var ids))
                    ids.Add(shift.StaffId);
                else VacationList[shift.Date] = [shift.StaffId];
            }
            else
            {
                shiftInfo = new ShiftInfo(selectedShiftDto.StartHalfHr, selectedShiftDto.WorkHr);
                if (AssignedShiftList.TryGetValue(shift.StaffId, out var shiftDic))
                    shiftDic[shift.Date] = shiftInfo;
                else AssignedShiftList[shift.StaffId] = new Dictionary<DateOnly, ShiftInfo>() { [shift.Date] = shiftInfo };
            }

            shift.Msg = _getShiftStr(shiftInfo, selectedShiftDto.Pto);
            shift.ChosenShift = selectedShiftDto;
        }
    }

    private string SelectShiftClass(ShiftItem shift)
    {
        if (shift.ChosenShift == null || shift.ChosenShift.SelectedShift == ShiftSelectDialog.Shift.無)
            return "";
        return "td-border";
    }

}